{
  "manifest_version": 3,
  "name": "Rewards Pro: Elite",
  "version": "5.4.0",
  "description": "Set the gear, secure the points. Automate your daily mission with precision human-mimicry and Chronos scheduling logic.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "notifications",
    "power",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "Icon/icon.png"
  },
  "icons": {
    "16": "Icon/icon.png",
    "48": "Icon/icon.png",
    "128": "Icon/icon.png"
  },
  "background": {
    "service_worker": "JS/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bing.com/*"
      ],
      "js": [
        "JS/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://www.bing.com/*"
  ]
}